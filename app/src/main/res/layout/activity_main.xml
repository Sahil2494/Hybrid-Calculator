<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/holo_blue_dark">

    <TextView
        android:id="@+id/resultTv"
        android:hint="0"
        android:textSize="30sp"
        android:gravity="end|bottom"
        android:layout_marginTop="60dp"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#69EEC9"
        />

    <GridLayout
        android:layout_marginTop="40dp"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:rowCount="6"
        android:columnCount="4">

        <Button
            android:id="@+id/underRootBtn"
            android:onClick="rootAction"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:background="@drawable/circular_button"
            android:paddingEnd="10dp"
            android:text="@string/root"
            android:textSize="48sp"
            android:tooltipText="UnderRoot" />

        <ImageButton
            android:id="@+id/piBtn"
            android:onClick="piAction"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:background="@drawable/circular_button"
            android:contentDescription="@string/pi"
            android:src="@mipmap/pi" />


        <Button
            android:text="^"
            android:onClick="powerAction"
            android:id="@+id/exponentBtn"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:background="@drawable/circular_button"
            android:layout_columnWeight="1"
            android:layout_columnSpan="1"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:tooltipText="exponent"/>

        <Button
            android:text="!"
            android:onClick="factorialAction"
            android:id="@+id/factorialBtn"
            android:layout_row="0"
            android:background="@drawable/circular_button"
            android:layout_rowWeight="1"
            android:layout_column="3"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_columnSpan="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:tooltipText="factorial: 3! = 3×2×1"/>


        <Button
            android:id="@+id/acBtn"
            android:onClick="allClearAction"
            android:layout_width="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:background="@drawable/circular_button"
            android:backgroundTint="#AE38EE"
            android:text="@string/AC"
            android:textColor="#CFE4E8"
            android:textSize="48sp" />
        <Button
            android:text="( "
            android:onClick="openBracketAction"
            android:gravity="center"
            android:id="@+id/openBracketBtn"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_width="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="1" />
        <Button
            android:text=" )"
            android:id="@+id/closeBracketBtn"
            android:onClick="closeBracketAction"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_row="1"
            android:layout_column="2" />
        <Button
            android:text="÷"
            android:onClick="operationAction"
            android:id="@+id/divisionBtn"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_row="1"
            android:layout_width="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:textSize="48sp"
            android:layout_column="3"/>

        <Button
            android:text="7"
            android:onClick="numberAction"
            android:id="@+id/sevenBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_width="0dp"
            android:layout_row="2"
            android:layout_columnWeight="1"
            android:layout_column="0"/>
        <Button
            android:text="8"
            android:onClick="numberAction"
            android:id="@+id/eightBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_row="2"
            android:layout_columnWeight="1"
            android:layout_column="1"/>
        <Button
            android:text="9"
            android:onClick="numberAction"
            android:id="@+id/nineBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_row="2"
            android:layout_column="2"/>
        <Button
            android:text="×"
            android:onClick="operationAction"
            android:id="@+id/multiplyBtn"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_column="3"/>

        <Button
            android:text="4"
            android:onClick="numberAction"
            android:id="@+id/fourBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_column="0"/>
        <Button
            android:text="5"
            android:onClick="numberAction"
            android:id="@+id/fiveBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="3"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="1"/>
        <Button
            android:text="6"
            android:id="@+id/sixBtn"
            android:onClick="numberAction"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_column="2"/>
        <Button
            android:text="-"
            android:onClick="operationAction"
            android:id="@+id/minusBtn"
            android:layout_row="3"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="58sp"
            android:layout_columnWeight="1"
            android:layout_column="3"/>

        <Button
            android:text="1"
            android:onClick="numberAction"
            android:id="@+id/oneBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="4"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="0"/>
        <Button
            android:text="2"
            android:onClick="numberAction"
            android:id="@+id/twoBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="4"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_width="0dp"
            android:layout_columnWeight="1"
            android:layout_column="1"/>
        <Button
            android:text="3"
            android:onClick="numberAction"
            android:id="@+id/threeBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="4"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="2"/>
        <Button
            android:text="+"
            android:onClick="operationAction"
            android:id="@+id/plusBtn"
            android:background="@drawable/circular_button"
            android:backgroundTint="#43E890"
            android:layout_row="4"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="3"/>

        <Button
            android:text="0"
            android:onClick="numberAction"
            android:id="@+id/zeroBtn"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="5"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="0"/>
        <Button
            android:text="."
            android:id="@+id/decimalBtn"
            android:onClick="decimalAction"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:gravity="center_horizontal"
            android:layout_row="5"
            android:layout_rowWeight="1"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="1"/>
        <Button
            android:text="⌫"
            android:id="@+id/backspaceBtn"
            android:onClick="backspaceAction"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/circular_numbers"
            android:layout_row="5"
            android:layout_width="0dp"
            android:textSize="48sp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_column="2" />
        <Button
            android:text="="
            android:onClick="equalsAction"
            android:id="@+id/equalsToBtn"
            android:background="@drawable/circular_button"
            android:backgroundTint="#49E840"
            android:layout_row="5"
            android:layout_width="0dp"
            android:layout_rowWeight="1"
            android:textSize="48sp"
            android:layout_columnWeight="1"
            android:layout_column="3"/>

    </GridLayout>

</LinearLayout>